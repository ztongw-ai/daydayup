# 复制本文件为 .env.local 并填入你自己的 API Key
# Copy this file to .env.local and fill in your own API key
# （.env.local 已被 .gitignore 排除，不会被提交 / never committed）

# 智谱 GLM API Key（在 https://bigmodel.cn 控制台获取）
# Zhipu GLM API key from https://bigmodel.cn
VITE_GLM_API_KEY=

# 任意 OpenAI 兼容端点（也可在应用内"设置"里随时修改）
# Any OpenAI-compatible endpoint (can also be changed in app settings)
VITE_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VITE_GLM_MODEL=glm-4.6
